{
  "name": "@dsh-external/dsh-plugin-astrology",
  "version": "0.1.0",
  "description": "Astrology theme and Desktop personalization plugin for DeepSeek Harness",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib", "cordis.patch.yml", "resources/desktop", "LICENSE", "README.md", "README.zh-CN.md",
    "NOTICE.txt", "DSH-PET-MIT.txt", "HOST-INTEGRATION.md", "ASSET-LICENSES.md",
    "CONTRIBUTING.md", "SECURITY.md", "GITHUB-SETUP.md", "CHANGELOG.md"
  ],
  "license": "MIT",
  "keywords": ["dsh-plugin", "dsh", "deepseek-harness", "cordis", "desktop", "theme", "astrology"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra2425/dsh-astrology.git"
  },
  "bugs": { "url": "https://github.com/astra2425/dsh-astrology/issues" },
  "homepage": "https://github.com/astra2425/dsh-astrology#readme",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  }
}
